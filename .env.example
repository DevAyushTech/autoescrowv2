# Copy this file to .env for local development.
# These are development-only credentials. Never use them outside local development.

AUTOESCROW_ENVIRONMENT=local
AUTOESCROW_DEBUG=false
AUTOESCROW_LOG_LEVEL=INFO
AUTOESCROW_LOG_JSON=true
AUTOESCROW_DATABASE_URL=postgresql+asyncpg://autoescrow:autoescrow@localhost:5432/autoescrow
AUTOESCROW_REDIS_URL=redis://localhost:6379/0

# Required. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real value. `make env` fills this in for local development.
AUTOESCROW_JWT_SECRET=

# Sepolia-only in M1. The domain and URI must match the browser origin that
# requests the signature. Update both before pointing the deployed frontend here.
AUTOESCROW_ETHEREUM_CHAIN_ID=11155111
AUTOESCROW_SIWE_DOMAIN=localhost:8000
AUTOESCROW_SIWE_URI=http://localhost:8000
AUTOESCROW_SIWE_STATEMENT=Sign in to AutoEscrow.
